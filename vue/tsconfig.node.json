{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "outDir": "./node_modules/.cache/tsconfig-node",
    "noEmit": true
  },
  "include": [
    "vite.config.ts"
  ]
}
